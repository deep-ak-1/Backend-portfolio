# Copy this file to server/.env and fill in real values. Never commit server/.env.
PORT=5000
NODE_ENV=development

# Must match the Vite dev server address (comma-separate for several origins)
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=2h

# Used only by: npm run admin:create (remove the password line after running it)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-strong-password-of-12-or-more-chars
ADMIN_NAME=Administrator
